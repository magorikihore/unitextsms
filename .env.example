APP_NAME=UniNText
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unintext
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS="noreply@triptz.net"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun (https://app.mailgun.com)
# Use api.eu.mailgun.net if your domain is in the EU region
MAILGUN_DOMAIN=mg.triptz.net
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAILGUN_SCHEME=https

# Optional SMTP fallback
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

VITE_APP_NAME="${APP_NAME}"

SMS_PROVIDER_DRIVER=log
SMS_PROVIDER_TPS=20
SMS_OTP_TPS=10
SMS_TRANSACTIONAL_TPS=6
SMS_BULK_TPS=4
SMS_DEFAULT_RATE_LIMIT=18
SMS_OTP_LATENCY_PAUSE_MS=3000
SMS_OTP_TTL_MINUTES=5
JASMIN_BASE_URL=
JASMIN_USERNAME=
JASMIN_PASSWORD=
JASMIN_DLR_URL="${APP_URL}/dlr/jasmin"
# Comma-separated IPs/CIDRs allowed to hit DLR endpoints (required in production)
JASMIN_DLR_ALLOWED_IPS=
UNITXT_IMPORT_DEFAULT_PROVIDER_ID=

# PayIn mobile money deposits (https://docs.payin.co.tz)
PAYIN_ENABLED=false
PAYIN_BASE_URL=https://api.sandbox.payin.co.tz/api/v1
PAYIN_API_KEY=
PAYIN_API_SECRET=
PAYIN_WEBHOOK_SECRET=
PAYIN_CURRENCY=TZS
PAYIN_MIN_AMOUNT=100
PAYIN_MAX_AMOUNT=10000000

# Legacy Unitext DB (SSH tunnel recommended: ssh -L 3307:127.0.0.1:3306 jasmin-gateway)
UNITXT_LEGACY_DB_HOST=127.0.0.1
UNITXT_LEGACY_DB_PORT=3307
UNITXT_LEGACY_DB_DATABASE=unitxt
UNITXT_LEGACY_DB_USERNAME=
UNITXT_LEGACY_DB_PASSWORD=
UNITXT_IMPORT_DEFAULT_PRICE=0.05
UNITXT_IMPORT_DEFAULT_PROVIDER_ID=
